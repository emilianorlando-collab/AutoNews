    {
      "parameters": {
        "jsCode": "const items = $input.first().json.rss.channel.item;\n\nconst noticias = items.slice(0, 5).map((item, index) => ({\n  numero: index + 1,\n  titulo: item.title || \"Sin título\",\n  fecha: item.pubDate || \"Fecha no disponible\",\n  descripcion: (item.description || \"\").replace(/<[^>]*>/g, \"\").trim(),\n  link: item.link || \"\"\n}));\n\nreturn [\n  {\n    json: {\n      fechaReporte: new Date().toLocaleDateString(\"es-AR\", {\n        timeZone: \"America/Argentina/Buenos_Aires\",\n        day: \"2-digit\",\n        month: \"long\",\n        year: \"numeric\"\n      }),\n      noticias\n    }\n  }\n];"
